.env
.env.*
!.env.example
*.test
/swe-swe-tunneld
.swe-swe/

# Per-host Compose override. Compose auto-merges docker-compose.override.yml
# onto the base. We keep it gitignored so the alternate cert-less
# registration port (--register-listen-without-mtls) and its publish
# mapping never travel via the public repo — port obscurity is a thin
# defence-in-depth layer, not a lock (the allowlist + Ed25519 gate is).
# Copy docker-compose.override.yml.example and fill in a high,
# non-obvious port.
docker-compose.override.yml

# Allowlist contents are per-deployment operator config (Ed25519 pubkey
# files for the Register gate). Public keys are not secret, but they are
# host-local policy and should NOT travel via the codebase. Anyone who
# clones the repo gets an empty directory and must seed their own keys.
/allowlist/*
!/allowlist/.gitkeep

# Staging area for mTLS artifacts produced by
# /generate-mtls-p12-for-device and /generate-mtls-crt-for-client.
# Holds .p12 + .txt (passphrase) pairs and .crt files destined for
# browsers / agent hosts. Sensitive: .p12 contains a fresh private
# key under passphrase, .txt is the passphrase. Delete each file as
# soon as the target device finishes import.
/generated/

# Pre-deploy snapshots produced by /run-production. Each snapshot
# is a tar.gz of the tunnel-data volume + ./allowlist + .env, taken
# just before a rebuild so a broken deploy is recoverable. Last 5
# kept on disk by default. Sensitive (LE account key, CA private
# key, DNS API token); never travel via the codebase.
/backups/
